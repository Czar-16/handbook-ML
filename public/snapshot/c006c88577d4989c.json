{"path":"src/components/usage/PlanCard.tsx","text":"\"use client\";\n\nimport Link from \"next/link\";\nimport { useId } from \"react\";\nimport {\n  ArrowRight,\n  BellRing,\n  Check,\n  Crown,\n  FileText,\n  Info,\n  Mail,\n  PanelsTopLeft,\n  Send,\n  Sun,\n  Zap,\n} from \"lucide-react\";\nimport type { BillingControlsPresentation } from \"@/components/billing-controls\";\nimport { Tooltip } from \"@/components/ui/Tooltip\";\nimport { ROLE_SHORTCUT_LIMITS, PLANS, PLAN_LABELS } from \"@/lib/plans\";\nimport { PRICE_TAX_DESCRIPTION } from \"@/lib/pricing\";\nimport styles from \"./usage.module.css\";\nimport { cn } from \"@/lib/utils\";\n\nconst focusRing =\n  \"focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--appearance-focus,var(--billing-focus-ink))]\";\nexport function PlanCard({\n  controls: c,\n}: {\n  controls: BillingControlsPresentation;\n}) {\n  const b = c.billing;\n  const titleId = useId();\n  const premium = b?.plan === \"PAID\";\n  const limits = b ? PLANS[b.plan] : null;\n  const chips =\n    limits && !premium\n      ? [\n          {\n            value: limits.campaignRecipients,\n            label: \"recipients / campaign\",\n            icon: Send,\n          },\n          {\n            value: limits.savedTemplates ?? \"Unlimited\",\n            label:\n              limits.savedTemplates === 1\n                ? \"saved template\"\n                : \"saved templates\",\n            icon: PanelsTopLeft,\n          },\n          {\n            value: ROLE_SHORTCUT_LIMITS.free,\n            label: \"role shortcuts\",\n            icon: Zap,\n          },\n        ]\n      : [];\n\n  return (\n    <div className=\"@container w-full min-w-0\">\n      <section\n        aria-labelledby={titleId}\n        data-usage-plan-card\n        className={cn(\n          \"grid w-full min-w-0 grid-cols-1 overflow-hidden rounded-[28px] border border-[var(--plan-v5-line)] bg-[var(--plan-v5-card)] font-[family-name:var(--font-price)] text-base leading-normal text-[var(--plan-v5-text)] [--button-hover-filter:none] [&_:is(button,a,summary):focus-visible]:outline-2 [&_:is(button,a,summary):focus-visible]:outline-offset-4 [&_:is(button,a,summary):focus-visible]:outline-[var(--appearance-focus,var(--billing-focus-ink))]\",\n          !premium && \"@min-[861px]:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]\",\n        )}\n      >\n        <div\n          data-plan-summary\n          className={cn(\n            \"flex min-w-0 flex-col\",\n            premium ? \"gap-0\" : \"gap-6 p-6 @min-[861px]:p-8\",\n          )}\n        >\n          <div\n            className={cn(\n              \"flex items-start justify-between gap-3\",\n              premium &&\n                \"border-b border-[var(--plan-v5-line)] px-6 py-6 @min-[861px]:px-8\",\n            )}\n          >\n            <div className=\"min-w-0\">\n              {!premium && (\n                <p className=\"font-[family-name:var(--font-jetbrains)] text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--plan-v5-muted)]\">\n                  Current plan\n                </p>\n              )}\n              <h2\n                id={titleId}\n                className={cn(\n                  \"mt-2 text-[38px]! font-extrabold! leading-tight! tracking-[-0.045em]!\",\n                  premium && \"mt-0 flex items-center gap-3 text-[30px]!\",\n                )}\n              >\n                {premium && (\n                  <span className=\"grid size-11 shrink-0 place-items-center rounded-[14px] bg-[image:var(--plan-v5-tile)] text-[var(--plan-v5-tile-ink)] shadow-[inset_0_1px_0_var(--plan-v5-tile-highlight)]\">\n                    <Crown className=\"size-5\" aria-hidden=\"true\" />\n                  </span>\n                )}\n                {!b\n                  ? \"Loading…\"\n                  : b.isSuspended\n                    ? \"Suspended\"\n                    : PLAN_LABELS[b.plan]}\n              </h2>\n              <div className=\"flex flex-wrap items-center gap-[0.6em] mt-[0.3em] text-[0.82em] text-[var(--plan-v5-muted)]\">\n                <span>\n                  {!b\n                    ? \"Loading subscription status…\"\n                    : b.status === \"NONE\"\n                      ? \"No active subscription\"\n                      : `Subscription: ${b.status.toLowerCase().replaceAll(\"_\", \" \")}`}\n                </span>\n                <Tooltip\n                  className={styles.surface}\n                  maxWidth={300}\n                  content=\"An active access override or grant affects your access separately from your subscription.\"\n                >\n                  <button\n                    type=\"button\"\n                    aria-label=\"About access overrides\"\n                    className={`${focusRing} grid w-[1.4em] h-[1.4em] place-items-center [border:0.0625em_solid_var(--plan-v5-line)] rounded-[50%] cursor-help`}\n                  >\n                    <Info className=\"size-[0.95em]\" aria-hidden=\"true\" />\n                  </button>\n                </Tooltip>\n                {b?.mode === \"test\" && (\n                  <Tooltip\n                    className={styles.surface}\n                    maxWidth={300}\n                    content=\"Test mode only. Use Dodo test payment details; no real charges are enabled. Enter your billing country in Dodo checkout, then review the final price, currency, and applicable taxes before paying.\"\n                  >\n                    <button\n                      type=\"button\"\n                      className={`${focusRing} inline-flex items-center gap-[0.45em] [padding:0.3em_0.7em_0.3em_0.6em] rounded-[99em] [background:var(--plan-v5-warn-bg)] text-[var(--plan-v5-warn)] text-[0.84em] font-bold whitespace-nowrap cursor-help`}\n                    >\n                      <span\n                        className={`size-[0.5em] rounded-full bg-current`}\n                        aria-hidden=\"true\"\n                      />\n                      Test mode\n                    </button>\n                  </Tooltip>\n                )}\n              </div>\n            </div>\n          </div>\n          {premium ? (\n            <div className=\"min-w-0 bg-[var(--plan-v5-cell)] p-6 @min-[861px]:p-8\">\n              <h3 className=\"text-sm! font-semibold! tracking-normal!\">\n                Included with Premium\n              </h3>\n              <ul\n                aria-label=\"Included in your plan\"\n                className=\"mt-5 grid gap-x-5 gap-y-5 @min-[620px]:grid-cols-2 @min-[1080px]:grid-cols-4\"\n              >\n                {[\n                  {\n                    title: `${limits?.campaignRecipients} recipients per campaign`,\n                    detail: \"Personalize each send\",\n                    icon: Send,\n                  },\n                  {\n                    title: \"Unlimited saved templates\",\n                    detail: \"Keep every version ready\",\n                    icon: PanelsTopLeft,\n                  },\n                  {\n                    title: \"CSV contact import\",\n                    detail: \"Bring in up to 1,000 rows\",\n                    icon: FileText,\n                  },\n                  {\n                    title: \"Follow-up reminders\",\n                    detail: \"Choose 3, 7, or 14 days\",\n                    icon: BellRing,\n                  },\n                ].map(({ title, detail, icon: Icon }) => (\n                  <li key={title} className=\"flex min-w-0 items-start gap-3\">\n                    <span className=\"grid size-8 shrink-0 place-items-center rounded-lg border border-[var(--plan-v5-cell-line)] bg-[var(--plan-v5-card)] text-[var(--plan-v5-accent)]\">\n                      <Icon className=\"size-4\" aria-hidden=\"true\" />\n                    </span>\n                    <span className=\"min-w-0\">\n                      <strong className=\"block text-sm font-semibold leading-snug\">\n                        {title}\n                      </strong>\n                      <span className=\"mt-0.5 block text-xs leading-relaxed text-[var(--plan-v5-muted)]\">\n                        {detail}\n                      </span>\n                    </span>\n                  </li>\n                ))}\n              </ul>\n              <Link\n                href=\"/pricing\"\n                className={`${focusRing} mt-6 inline-flex w-fit items-center gap-1.5 text-xs font-semibold text-[var(--plan-v5-accent)] underline-offset-4 css-hover:underline`}\n              >\n                All Premium features\n                <ArrowRight className=\"size-3.5\" aria-hidden=\"true\" />\n              </Link>\n            </div>\n          ) : (\n            <p className=\"max-w-[36ch] text-sm leading-relaxed text-[var(--plan-v5-muted)]\">\n              {!limits ? (\n                \"Loading your plan limits…\"\n              ) : (\n                <>\n                  Send up to{\" \"}\n                  <strong className=\"font-semibold text-[var(--plan-v5-text)]\">\n                    {limits.dailyEmails} personalized emails a day\n                  </strong>{\" \"}\n                  and{\" \"}\n                  <strong className=\"font-semibold text-[var(--plan-v5-text)]\">\n                    {limits.monthlyEmails} a month\n                  </strong>{\" \"}\n                  through your own Gmail account.\n                </>\n              )}\n            </p>\n          )}\n          {!premium && (\n            <ul\n              aria-label=\"Included in your plan\"\n              className=\"m-0 flex list-none flex-wrap gap-2 p-0\"\n            >\n              {chips.map(({ value, label, icon: Icon }) => (\n                <li\n                  key={label}\n                  className=\"inline-flex min-w-0 items-center gap-2 rounded-full border border-[var(--plan-v5-cell-line)] bg-[var(--plan-v5-cell)] px-3 py-2 text-xs text-[var(--plan-v5-muted)]\"\n                >\n                  <Icon\n                    className=\"size-3.5 flex-none text-[var(--plan-v5-muted)]\"\n                    aria-hidden=\"true\"\n                  />\n                  <span>\n                    <strong className=\"font-semibold text-[var(--plan-v5-text)]\">\n                      {value}\n                    </strong>{\" \"}\n                    {label}\n                  </span>\n                </li>\n              ))}\n            </ul>\n          )}\n          {!premium && (\n            <div className=\"my-auto rounded-2xl border border-[var(--plan-v5-cell-line)] bg-[var(--plan-v5-cell)] p-4 @min-[480px]:p-5\">\n              <h3 className=\"text-sm! font-bold! tracking-normal!\">\n                Included with Free\n              </h3>\n              <ul className=\"mt-4 grid gap-3 text-sm text-[var(--plan-v5-muted)]\">\n                <li className=\"flex items-start gap-2.5\">\n                  <Check\n                    className=\"mt-0.5 size-4 shrink-0 text-[var(--plan-v5-accent)]\"\n                    aria-hidden=\"true\"\n                  />\n                  Personalized emails through your own Gmail\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check\n                    className=\"mt-0.5 size-4 shrink-0 text-[var(--plan-v5-accent)]\"\n                    aria-hidden=\"true\"\n                  />\n                  One PDF attachment, up to 5 MB\n                </li>\n                <li className=\"flex items-start gap-2.5\">\n                  <Check\n                    className=\"mt-0.5 size-4 shrink-0 text-[var(--plan-v5-accent)]\"\n                    aria-hidden=\"true\"\n                  />\n                  Gmail acceptance status for sent emails\n                </li>\n              </ul>\n              <p className=\"mt-4 border-t border-dotted border-separator pt-3 text-xs leading-relaxed text-[var(--plan-v5-muted)]\">\n                Your remaining daily and monthly allowances are shown below.\n              </p>\n            </div>\n          )}\n        </div>\n        {!premium && (\n          <aside\n            data-plan-comparison\n            aria-label=\"Plan limit comparison\"\n            className=\"flex min-w-0 flex-col gap-6 border-t border-dotted border-separator [background:linear-gradient(155deg,var(--plan-v5-cell),var(--plan-v5-card))] p-6 @min-[861px]:border-t-0 @min-[861px]:border-l @min-[861px]:p-8\"\n          >\n            <div>\n              <div className=\"flex items-center gap-3\">\n                <span className=\"grid size-11 shrink-0 place-items-center rounded-[14px] bg-[image:var(--plan-v5-tile)] text-[var(--plan-v5-tile-ink)] shadow-[inset_0_1px_0_var(--plan-v5-tile-highlight)]\">\n                  <Crown className=\"size-5\" aria-hidden=\"true\" />\n                </span>\n                <div className=\"min-w-0\">\n                  <p className=\"font-[family-name:var(--font-jetbrains)] text-[11px] font-medium uppercase tracking-[0.14em] text-[var(--plan-v5-muted)]\">\n                    Your plan, compared\n                  </p>\n                  <h3 className=\"mt-1 text-xl! font-bold! tracking-[-0.03em]!\">\n                    More room to reach out\n                  </h3>\n                </div>\n              </div>\n              <p className=\"mt-3 text-sm leading-relaxed text-[var(--plan-v5-muted)]\">\n                Premium raises your sending limits and unlocks tools for larger\n                campaigns.\n              </p>\n            </div>\n            <div className=\"grid gap-4 @min-[960px]:grid-cols-2\">\n              {(\n                [\n                  {\n                    key: \"dailyEmails\",\n                    label: \"Daily sending limit\",\n                    unit: \"day\",\n                    icon: Sun,\n                  },\n                  {\n                    key: \"monthlyEmails\",\n                    label: \"Monthly sending limit\",\n                    unit: \"month\",\n                    icon: Mail,\n                  },\n                ] as const\n              ).map(({ key, label, unit, icon: Icon }) => (\n                <div\n                  key={key}\n                  className=\"rounded-2xl border border-[var(--plan-v5-cell-line)] bg-[var(--plan-v5-card)] p-4\"\n                >\n                  <div className=\"mb-3 flex items-center gap-2 text-xs font-semibold text-[var(--plan-v5-text)]\">\n                    <Icon\n                      className=\"size-4 text-[var(--plan-v5-accent)]\"\n                      aria-hidden=\"true\"\n                    />\n                    {label}\n                  </div>\n                  <div\n                    role=\"meter\"\n                    aria-label={`${label} — plan comparison`}\n                    aria-valuemin={0}\n                    aria-valuemax={PLANS.PAID[key]}\n                    aria-valuenow={limits?.[key] ?? 0}\n                    aria-valuetext={\n                      limits\n                        ? `${limits[key]} emails per ${unit} on Free; ${PLANS.PAID[key]} on Premium`\n                        : \"Loading plan limits\"\n                    }\n                    className=\"grid gap-3\"\n                  >\n                    <div className=\"grid gap-1.5\">\n                      <div className=\"flex items-baseline justify-between gap-2 text-xs\">\n                        <span className=\"font-medium text-[var(--plan-v5-muted)]\">\n                          Free · current\n                        </span>\n                        <strong className=\"font-bold tabular-nums text-[var(--plan-v5-text)]\">\n                          {limits?.[key] ?? \"—\"}{\" \"}\n                          <span className=\"font-normal text-[var(--plan-v5-muted)]\">\n                            / {unit}\n                          </span>\n                        </strong>\n                      </div>\n                      <div className=\"h-2.5 overflow-hidden rounded-full bg-[var(--plan-v5-cell-line)]\">\n                        <div\n                          data-plan-limit={key}\n                          className=\"h-full rounded-full bg-[var(--plan-v5-muted)]\"\n                          style={{\n                            width: `${limits ? Math.min(100, (limits[key] / PLANS.PAID[key]) * 100) : 0}%`,\n                          }}\n                        />\n                      </div>\n                    </div>\n                    <div className=\"grid gap-1.5\">\n                      <div className=\"flex items-baseline justify-between gap-2 text-xs\">\n                        <span className=\"font-semibold text-[var(--plan-v5-accent)]\">\n                          Premium\n                        </span>\n                        <strong className=\"font-bold tabular-nums text-[var(--plan-v5-text)]\">\n                          {PLANS.PAID[key]}{\" \"}\n                          <span className=\"font-normal text-[var(--plan-v5-muted)]\">\n                            / {unit}\n                          </span>\n                        </strong>\n                      </div>\n                      <div className=\"h-2.5 overflow-hidden rounded-full bg-[var(--plan-v5-cell-line)]\">\n                        <div className=\"h-full w-full rounded-full bg-linear-to-r from-[var(--plan-v5-accent)] to-[var(--plan-v5-accent2)]\" />\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              ))}\n            </div>\n            <div>\n              <h4 className=\"text-sm! font-bold! tracking-normal!\">\n                More with Premium\n              </h4>\n              <ul className=\"mt-3 grid gap-x-4 gap-y-3 @min-[480px]:grid-cols-2\">\n                <li className=\"flex items-start gap-2.5 text-xs leading-relaxed text-[var(--plan-v5-muted)]\">\n                  <Send\n                    className=\"mt-0.5 size-4 shrink-0 text-[var(--plan-v5-accent)]\"\n                    aria-hidden=\"true\"\n                  />\n                  <span>\n                    <strong className=\"block text-[var(--plan-v5-text)]\">\n                      {PLANS.PAID.campaignRecipients} recipients per campaign\n                    </strong>\n                    Up from {PLANS.FREE.campaignRecipients} on Free\n                  </span>\n                </li>\n                <li className=\"flex items-start gap-2.5 text-xs leading-relaxed text-[var(--plan-v5-muted)]\">\n                  <PanelsTopLeft\n                    className=\"mt-0.5 size-4 shrink-0 text-[var(--plan-v5-accent)]\"\n                    aria-hidden=\"true\"\n                  />\n                  <span>\n                    <strong className=\"block text-[var(--plan-v5-text)]\">\n                      Unlimited templates\n                    </strong>\n                    Up from {PLANS.FREE.savedTemplates} on Free\n                  </span>\n                </li>\n                <li className=\"flex items-start gap-2.5 text-xs leading-relaxed text-[var(--plan-v5-muted)]\">\n                  <FileText\n                    className=\"mt-0.5 size-4 shrink-0 text-[var(--plan-v5-accent)]\"\n                    aria-hidden=\"true\"\n                  />\n                  <span>\n                    <strong className=\"block text-[var(--plan-v5-text)]\">\n                      CSV contact import\n                    </strong>\n                    Add contacts in bulk\n                  </span>\n                </li>\n                <li className=\"flex items-start gap-2.5 text-xs leading-relaxed text-[var(--plan-v5-muted)]\">\n                  <BellRing\n                    className=\"mt-0.5 size-4 shrink-0 text-[var(--plan-v5-accent)]\"\n                    aria-hidden=\"true\"\n                  />\n                  <span>\n                    <strong className=\"block text-[var(--plan-v5-text)]\">\n                      Follow-up reminders\n                    </strong>\n                    Choose 3, 7, or 14 days\n                  </span>\n                </li>\n              </ul>\n            </div>\n            <div className=\"mt-auto rounded-2xl border border-[var(--plan-v5-cell-line)] bg-[var(--plan-v5-card)] p-4 @min-[480px]:p-5\">\n              <div className=\"mb-4 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1\">\n                <span className=\"text-sm font-bold\">Premium</span>\n                <p data-localized-price className=\"flex items-baseline gap-0.5\">\n                  <b className=\"font-[family-name:var(--font-price-amount)] bg-[image:var(--plan-price-gradient)] bg-clip-text text-transparent text-2xl font-extrabold tracking-tight\">\n                    {c.publicPrice.replace(\"/month\", \"\")}\n                  </b>\n                  <span className=\"text-xs text-[var(--plan-v5-muted)]\">\n                    /mo\n                  </span>\n                </p>\n              </div>\n              <div className=\"grid gap-2 @min-[480px]:grid-cols-[minmax(0,1fr)_auto]\">\n                <button\n                  type=\"button\"\n                  className={cn(\n                    `inline-flex min-w-0 items-center justify-center gap-2 rounded-xl border-0 [background:var(--primary-action-gradient)] px-4 py-3 text-center text-sm font-bold text-[var(--primary-action-ink)] shadow-[inset_0_1px_0_var(--plan-v5-button-highlight)] cursor-pointer disabled:cursor-not-allowed disabled:opacity-55 ${focusRing}`,\n                    \"upgrade-shine relative isolate overflow-hidden\",\n                  )}\n                  aria-busy={c.busy}\n                  disabled={!c.canUpgrade || c.busy || !b?.checkoutEnabled}\n                  onClick={() => void c.open(\"checkout\")}\n                >\n                  {c.busy ? \"Opening…\" : `Upgrade to ${PLAN_LABELS.PAID}`}\n                  <ArrowRight className=\"size-4 shrink-0\" aria-hidden=\"true\" />\n                </button>\n                <Link\n                  href=\"/pricing\"\n                  className={`button-interaction secondary-button ${focusRing} inline-flex items-center justify-center rounded-xl border border-[var(--plan-v5-line)] px-4 py-3 text-center text-sm font-semibold text-[var(--plan-v5-text)] no-underline`}\n                >\n                  Compare plans\n                </Link>\n              </div>\n              <p className=\"mt-3 text-xs leading-relaxed text-[var(--plan-v5-muted)]\">\n                {PRICE_TAX_DESCRIPTION} Billing country determines eligibility;\n                checkout shows the final price.\n              </p>\n              {c.lookupFailed && (\n                <p\n                  className=\"mt-3 text-xs text-[var(--plan-v5-warn)]\"\n                  role=\"alert\"\n                >\n                  Subscription status lookup temporarily failed. Your last\n                  verified status is retained. Try refreshing shortly.\n                </p>\n              )}\n              {c.message && (\n                <p\n                  className={cn(\n                    \"mt-3 text-xs text-[var(--status-error-text)]\",\n                    c.message ===\n                      \"Cancellation requested. Waiting for confirmation.\" &&\n                      \"text-[var(--plan-v5-warn)]\",\n                  )}\n                  role=\"alert\"\n                >\n                  {c.message}\n                </p>\n              )}\n            </div>\n          </aside>\n        )}\n      </section>\n    </div>\n  );\n}\n","hash":"7804b7587da6e8caee29318916fa3cc902ca538f5960b62f4cff5d4bc602e118","originalHash":"7804b7587da6e8caee29318916fa3cc902ca538f5960b62f4cff5d4bc602e118","lines":510}