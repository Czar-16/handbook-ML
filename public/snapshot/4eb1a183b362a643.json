{"path":"src/components/templates/TemplatesFreeView.tsx","text":"import Link from \"next/link\";\nimport { Download, FileText, Pencil, Plus } from \"lucide-react\";\nimport { DeleteButton } from \"@/components/forms\";\nimport { TemplateControls } from \"@/components/template-controls\";\nimport { FreePlanSidebar } from \"./FreePlanSidebar\";\nimport { HighlightedText } from \"./HighlightedText\";\nimport type { SavedTemplate } from \"./TemplateListItem\";\nimport styles from \"./templates.module.css\";\n\nexport function TemplatesFreeView({\n  template,\n  query,\n}: {\n  template: SavedTemplate | null;\n  query: Record<string, string>;\n}) {\n  return (\n    <div className={`${styles.scope} text-foreground min-w-0`}>\n      <header\n        className={`workspace-screen-heading flex justify-between items-end gap-5 flex-wrap [margin:16px_0_28px]`}\n      >\n        <div>\n          <p\n            className={`m-0 mb-2.5 text-[var(--tpl-token)] workspace-mono:text-[var(--coral)] [font:500_11.5px_var(--font-jetbrains),_monospace] tracking-[0.12em] uppercase`}\n          >\n            Templates\n          </p>\n          <h1 className=\"mt-2 text-[clamp(30px,4.6vw,46px)] leading-[1.08] tracking-[-0.04em] font-extrabold\">\n            Write once, personalise for everyone.\n          </h1>\n          <p className=\"text-[var(--tpl-muted)] mt-2\">\n            Create, edit, and manage the messages you use in Compose.\n          </p>\n        </div>\n      </header>\n      <div className=\"grid grid-cols-[minmax(0,_1fr)_300px] gap-6 items-start [@media(max-width:_820px)]:grid-cols-[minmax(0,_1fr)]\">\n        <div className=\"min-w-0\">\n          {template ? (\n            <article\n              className={`${styles.card} [background:var(--tpl-card)] [border:1px_solid_var(--tpl-line)] rounded-[22px] min-w-0 panel`}\n              aria-labelledby=\"active-free-template-title\"\n            >\n              <header\n                className={`flex justify-between items-start flex-wrap gap-4 py-6 px-6.5 [@media(max-width:_480px)]:p-5`}\n              >\n                <div className=\"flex-1 min-w-0\">\n                  <TemplateControls\n                    id={template.id}\n                    selected\n                    selectedVariant=\"library\"\n                  />\n                  <h2\n                    id=\"active-free-template-title\"\n                    tabIndex={-1}\n                    className=\"text-[26px] font-bold tracking-[-0.03em] mt-3 wrap-anywhere\"\n                  >\n                    {template.name}\n                  </h2>\n                </div>\n                <Link\n                  className={`${styles.primary} button-interaction primary-action [background:var(--primary-action-gradient)] text-[var(--primary-action-ink)] shadow-none inline-flex items-center justify-center gap-2 py-[11px] px-5.5 min-h-11 rounded-full font-bold text-[14px] [background:var(--primary-action-gradient)] text-[var(--primary-action-ink)] shadow-none no-underline shrink-0`}\n                  href={`/templates?${new URLSearchParams({ ...query, edit: template.id })}`}\n                >\n                  <Pencil size={16} aria-hidden=\"true\" />\n                  Edit template\n                </Link>\n              </header>\n              <div\n                className={`py-5 px-6.5 border-t border-dotted border-separator [@media(max-width:_480px)]:p-5`}\n              >\n                <p className=\"[font:500_11.5px_var(--font-jetbrains),_monospace] tracking-[0.12em] uppercase text-[var(--tpl-muted)] mb-2\">\n                  Subject\n                </p>\n                <p\n                  className={`text-inherit text-[17px] font-semibold whitespace-pre-wrap wrap-anywhere`}\n                >\n                  <HighlightedText text={template.subject} />\n                </p>\n              </div>\n              <div\n                className=\"py-5 px-6.5 border-t border-dotted border-separator text-[14.5px] leading-[1.7] max-h-130 overflow-y-auto [@media(max-width:_480px)]:p-5\"\n                role=\"region\"\n                aria-label=\"Template message\"\n                tabIndex={0}\n              >\n                <p className=\"[font:500_11.5px_var(--font-jetbrains),_monospace] tracking-[0.12em] uppercase text-[var(--tpl-muted)] mb-2\">\n                  Message\n                </p>\n                <div className=\"whitespace-pre-wrap wrap-anywhere\">\n                  <HighlightedText text={template.body} />\n                </div>\n              </div>\n              <footer\n                className={`flex gap-1.5 items-center flex-wrap justify-between py-3 px-5 border-t border-dotted border-separator`}\n              >\n                <a\n                  className=\"button-interaction ghost-button inline-flex items-center justify-center gap-2 py-2 px-[13px] min-h-11 rounded-[10px] text-[13.5px] font-semibold text-[var(--tpl-muted)] no-underline\"\n                  download\n                  href={`/api/templates/${template.id}/export`}\n                >\n                  <Download size={16} aria-hidden=\"true\" />\n                  Download JSON\n                </a>\n                <DeleteButton id={template.id} kind=\"template\" />\n              </footer>\n            </article>\n          ) : (\n            <div\n              className={`text-center py-12 px-5 text-[var(--tpl-muted)] [background:linear-gradient(_145deg,_var(--tpl-card)_45%,_color-mix(in_srgb,_var(--accent)_5%,_var(--tpl-card)))] [border:1px_dashed_var(--tpl-line-hover)] rounded-[22px] panel`}\n            >\n              <FileText\n                className=\"workspace-icon-glyph mx-auto mb-4\"\n                size={30}\n                aria-hidden=\"true\"\n              />\n              <h2 className=\"text-foreground text-[22px] font-bold\">\n                Create your first template\n              </h2>\n              <p className=\"mt-2.5 mb-6\">\n                Save a message you can personalise for every recipient.\n              </p>\n              <Link\n                className={`${styles.primary} button-interaction primary-action [background:var(--primary-action-gradient)] text-[var(--primary-action-ink)] shadow-none inline-flex items-center justify-center gap-2 py-[11px] px-5.5 min-h-11 rounded-full font-bold text-[14px] [background:var(--primary-action-gradient)] text-[var(--primary-action-ink)] shadow-none no-underline shrink-0`}\n                href={`/templates?${new URLSearchParams({ ...query, new: \"1\" })}`}\n              >\n                <Plus size={17} aria-hidden=\"true\" />\n                Create template\n              </Link>\n            </div>\n          )}\n          <p className=\"text-[var(--tpl-muted)] text-[13px] mt-4\">\n            Placeholders fill in each recipient’s details when you compose an\n            email.\n          </p>\n        </div>\n        <FreePlanSidebar used={!!template} />\n      </div>\n    </div>\n  );\n}\n","hash":"8cb631b677a6c32ab2a207a99f92d44aea2350742967267e64422e678c91314d","originalHash":"8cb631b677a6c32ab2a207a99f92d44aea2350742967267e64422e678c91314d","lines":141}