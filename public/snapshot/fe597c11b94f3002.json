{"path":"src/components/landing/features.tsx","text":"const statusClasses = {\n  re: \"lower-re bg-[var(--color-lower-sections-background-33)] text-[var(--pk)]\",\n  ok: \"lower-ok [background:var(--color-lower-sections-background-32)] text-[var(--gr)]\",\n  wa: \"lower-wa [background:var(--color-lower-sections-background-34)] text-[var(--ye)]\",\n} as const;\n\nexport function Features() {\n  return (\n    <section\n      className=\"scroll-mt-24 pt-12 min-[640px]:pt-18 min-[861px]:pt-24\"\n      id=\"features\"\n      aria-labelledby=\"features-title\"\n    >\n      <p className=\"lower-eyebrow [font:500_12px_var(--font-jetbrains),_monospace] tracking-[0.16em] uppercase text-[var(--pu)] mb-3.5\">\n        Everything in one place\n      </p>\n      <h2\n        className=\"[font-family:inherit] text-[clamp(30px,4.4vw,48px)]! leading-[1.08]! tracking-[-0.035em]! font-extrabold! max-w-[15em]!\"\n        id=\"features-title\"\n      >\n        Built for the outreach grind.\n      </h2>\n      <div className=\"lower-bento grid grid-cols-[repeat(6,_minmax(0,_1fr))] gap-5 mt-12 max-sm:mt-8\">\n        <article className=\"lower-panel backdrop-blur-[8px] p-6 flex flex-col gap-0 min-w-0 css-hover:border-[var(--line2)] [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden lower-b4 col-span-6 min-[640px]:col-span-3 min-[861px]:col-span-2\">\n          <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n            Reusable templates\n          </h3>\n          <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5 mb-5\">\n            Keep a version for startups, another for big tech.\n          </p>\n          <div className=\"lower-chips flex gap-2 flex-wrap mt-auto pt-5\">\n            {[\"Startups\", \"Big tech\", \"Referral ask\", \"Follow-up\"].map(\n              (text, i) => (\n                <span\n                  className={`lower-chip py-[7px] px-[13px] rounded-full [border:1px_solid_var(--line2)] text-[12.5px] font-semibold${i === 0 ? \" lower-a bg-[var(--color-lower-sections-background-31)]\" : \"\"}`}\n                  key={text}\n                >\n                  {text}\n                </span>\n              ),\n            )}\n          </div>\n        </article>\n        <article className=\"lower-panel backdrop-blur-[8px] p-6 flex flex-col gap-0 min-w-0 css-hover:border-[var(--line2)] [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden lower-b2 col-span-6 min-[640px]:col-span-3 min-[861px]:col-span-2\">\n          <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n            PDF attachment\n          </h3>\n          <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5 mb-5\">\n            Upload your PDF once. It goes with every email.\n          </p>\n          <div className=\"lower-pdf flex items-center gap-3 mt-auto p-3 rounded-[14px] [border:1px_dashed_var(--line2)]\">\n            <b className=\"grid place-items-center w-9.5 h-11.5 rounded-[8px] bg-[image:var(--grad)] text-[var(--color-lower-sections-color-29)] text-[11px]\">\n              PDF\n            </b>\n            <div className=\"lower-mini text-[12.5px]\">\n              attachment.pdf\n              <div className=\"lower-muted text-[var(--mu)]\">\n                Attached to every send\n              </div>\n            </div>\n          </div>\n        </article>\n        <article className=\"lower-panel backdrop-blur-[8px] p-6 flex flex-col gap-0 min-w-0 css-hover:border-[var(--line2)] [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden lower-b3 col-span-6 min-[640px]:col-span-3 min-[861px]:col-span-2\">\n          <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n            Submission tracking and manual reply marking\n          </h3>\n          <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5 mb-5\">\n            See what landed and who answered, without opening Gmail.\n          </p>\n          <div className=\"lower-vis mt-4.5 rounded-[14px] [background:var(--color-lower-sections-background-27)] [border:1px_solid_var(--line)] p-3.5 lower-mini text-[12.5px] lower-push mt-auto!\">\n            {[\n              [\"Priya Sharma\", \"Replied\", statusClasses.re],\n              [\"Alex Morgan\", \"Delivered\", statusClasses.ok],\n              [\"Riya Patel\", \"Sending\", statusClasses.wa],\n            ].map(([name, status, statusClass]) => (\n              <div\n                className=\"lower-row flex items-center gap-2.5 py-[7px] px-0 [@media(max-width:_860px)]:flex-wrap\"\n                key={name}\n              >\n                {name}\n                <span\n                  className={`lower-pill ml-auto py-[3px] px-2.5 rounded-full text-[11.5px] font-semibold [@media(max-width:_860px)]:whitespace-nowrap ${statusClass}`}\n                >\n                  {status}\n                </span>\n              </div>\n            ))}\n          </div>\n        </article>\n        <article className=\"lower-panel backdrop-blur-[8px] p-6 flex flex-col gap-0 min-w-0 css-hover:border-[var(--line2)] [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden lower-b3 col-span-6 min-[640px]:col-span-3 min-[861px]:col-span-2\">\n          <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n            Contact manager\n          </h3>\n          <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5 mb-5\">\n            Save recruiters and founders, so you never email the same person\n            twice by accident.\n          </p>\n          <div className=\"lower-vis mt-4.5 rounded-[14px] [background:var(--color-lower-sections-background-27)] [border:1px_solid_var(--line)] p-3.5 lower-mini text-[12.5px] lower-push mt-auto!\">\n            <div className=\"lower-row flex items-center gap-2.5 py-[7px] px-0 [@media(max-width:_860px)]:flex-wrap\">\n              <span className=\"lower-av w-6.5 h-6.5 rounded-[50%] [background:var(--line)] grid place-items-center text-[11px] font-bold flex-none\">\n                J\n              </span>\n              Jordan Lee\n              <span className=\"lower-pill ml-auto py-[3px] px-2.5 rounded-full text-[11.5px] font-semibold [@media(max-width:_860px)]:whitespace-nowrap lower-wa [background:var(--color-lower-sections-background-34)] text-[var(--ye)]\">\n                Already emailed\n              </span>\n            </div>\n            <div className=\"lower-row flex items-center gap-2.5 py-[7px] px-0 [@media(max-width:_860px)]:flex-wrap\">\n              <span className=\"lower-av w-6.5 h-6.5 rounded-[50%] [background:var(--line)] grid place-items-center text-[11px] font-bold flex-none\">\n                S\n              </span>\n              Sam Rivera\n              <span className=\"lower-pill ml-auto py-[3px] px-2.5 rounded-full text-[11.5px] font-semibold [@media(max-width:_860px)]:whitespace-nowrap lower-ok [background:var(--color-lower-sections-background-32)] text-[var(--gr)]\">\n                New\n              </span>\n            </div>\n          </div>\n        </article>\n        <article className=\"lower-panel backdrop-blur-[8px] p-6 flex flex-col gap-0 min-w-0 css-hover:border-[var(--line2)] [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden lower-b3 col-span-6 min-[640px]:col-span-3 min-[861px]:col-span-2\">\n          <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n            Your own Gmail\n          </h3>\n          <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5 mb-5\">\n            Emails come from your address and live in your Sent folder.\n          </p>\n          <div className=\"lower-gm flex items-center gap-3 mt-auto py-3 px-3.5 rounded-[14px] [background:var(--color-lower-sections-background-35)] [border:1px_solid_var(--line)]\">\n            <span\n              className=\"lower-av w-6.5 h-6.5 rounded-[50%] [background:var(--line)] grid place-items-center text-[11px] font-bold flex-none\"\n              aria-hidden=\"true\"\n            >\n              ✉\n            </span>\n            <div className=\"lower-mini text-[12.5px]\">\n              [REDACTED_EMAIL]\n              <div className=\"lower-muted text-[var(--mu)]\">Saved in Sent</div>\n            </div>\n          </div>\n        </article>\n        <article className=\"lower-panel backdrop-blur-[8px] p-6 flex flex-col gap-0 min-w-0 css-hover:border-[var(--line2)] [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden lower-b3 col-span-6 min-[640px]:col-span-3 min-[861px]:col-span-2\">\n          <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n            One email per recipient\n          </h3>\n          <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5 mb-5\">\n            No CC lists, no shared threads. Each intro reads personal.\n          </p>\n          <div className=\"lower-env flex gap-2.5 mt-auto pt-5\">\n            {[\"Priya\", \"Alex\", \"Sam\"].map((name) => (\n              <span\n                key={name}\n                className=\"flex-1 py-2.5 px-1.5 rounded-[12px] border border-[var(--line2)] text-center text-[12px] text-[var(--mu)]\"\n              >\n                {name}\n              </span>\n            ))}\n          </div>\n        </article>\n      </div>\n    </section>\n  );\n}\n","hash":"78ed56b609fa2d2db6d7e2451a53bcd70109c8acc1270289850f5aae72c78fbc","originalHash":"f6dbcf1e3317f1f34c9bf4801cc1eec8ca53c01459a1719cfb761dee855397e4","lines":161}