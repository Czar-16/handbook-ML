{"path":"src/components/landing/how-it-works.tsx","text":"export function HowItWorks() {\n  return (\n    <section\n      className=\"scroll-mt-24 pt-12 min-[640px]:pt-18 min-[861px]:pt-24\"\n      id=\"how\"\n      aria-labelledby=\"how-title\"\n    >\n      <p className=\"lower-eyebrow [font:500_12px_var(--font-jetbrains),_monospace] tracking-[0.16em] uppercase text-[var(--pu)] mb-3.5\">\n        From draft to conversation\n      </p>\n      <h2\n        className=\"[font-family:inherit] text-[clamp(30px,4.4vw,48px)]! leading-[1.08]! tracking-[-0.035em]! font-extrabold! max-w-[15em]!\"\n        id=\"how-title\"\n      >\n        Three steps. Each email goes out on its own.\n      </h2>\n      <div className=\"lower-steps grid grid-cols-[repeat(3,_1fr)] gap-5 mt-12 max-sm:mt-8 relative [@media(max-width:_860px)]:grid-cols-[1fr]\">\n        <article className=\"lower-step p-0 [background:none] [border:0] overflow-visible min-w-0 flex flex-col\">\n          <div className=\"lower-dot w-13.5 h-13.5 rounded-[50%] [background:var(--bg2)] [border:1.5px_solid_var(--line2)] grid place-items-center font-extrabold text-[18px] relative z-[1] shadow-[0_0_28px_var(--color-lower-sections-box-shadow-26)]\">\n            1\n          </div>\n          <div className=\"lower-panel backdrop-blur-[8px] mt-4.5 p-5.5 flex-1 flex flex-col [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden\">\n            <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n              Write your template\n            </h3>\n            <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5\">\n              Draft once with placeholders for name and company. Save it to\n              reuse.\n            </p>\n            <div className=\"lower-vis mt-auto rounded-[14px] [background:var(--color-lower-sections-background-27)] [border:1px_solid_var(--line)] p-3.5 lower-mini text-[12.5px]\">\n              Hi{\" \"}\n              <span className=\"lower-tok inline-block py-[1px] px-2 rounded-[7px] [background:var(--color-lower-sections-line-4)] text-[var(--pk)] [font:500_12.5px_var(--font-jetbrains),_monospace] wrap-anywhere\">\n                {\"{{name}}\"}\n              </span>\n              , I’m Anoop, a developer excited about what{\" \"}\n              <span className=\"lower-tok inline-block py-[1px] px-2 rounded-[7px] [background:var(--color-lower-sections-line-4)] text-[var(--pk)] [font:500_12.5px_var(--font-jetbrains),_monospace] wrap-anywhere\">\n                {\"{{company}}\"}\n              </span>{\" \"}\n              is building…\n              <div\n                className=\"lower-line h-[7px] rounded-[4px] [background:var(--line)] mt-[9px]\"\n                style={{ width: \"90%\" }}\n              />\n              <div\n                className=\"lower-line h-[7px] rounded-[4px] [background:var(--line)] mt-[9px]\"\n                style={{ width: \"62%\" }}\n              />\n            </div>\n          </div>\n        </article>\n        <article className=\"lower-step p-0 [background:none] [border:0] overflow-visible min-w-0 flex flex-col\">\n          <div className=\"lower-dot w-13.5 h-13.5 rounded-[50%] [background:var(--bg2)] [border:1.5px_solid_var(--line2)] grid place-items-center font-extrabold text-[18px] relative z-[1] shadow-[0_0_28px_var(--color-lower-sections-box-shadow-26)]\">\n            2\n          </div>\n          <div className=\"lower-panel backdrop-blur-[8px] mt-4.5 p-5.5 flex-1 flex flex-col [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden\">\n            <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n              Pick up to 3 contacts\n            </h3>\n            <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5\">\n              Choose from your saved contacts and attach your resume.\n            </p>\n            <div className=\"lower-vis mt-auto rounded-[14px] [background:var(--color-lower-sections-background-27)] [border:1px_solid_var(--line)] p-3.5 lower-mini text-[12.5px]\">\n              {[\"Priya Sharma\", \"Alex Morgan\", \"Sam Rivera\"].map((name, i) => (\n                <div\n                  className=\"lower-row flex items-center gap-2.5 py-[7px] px-0 [@media(max-width:_860px)]:flex-wrap\"\n                  key={name}\n                >\n                  <span className=\"lower-av w-6.5 h-6.5 rounded-[50%] [background:var(--line)] grid place-items-center text-[11px] font-bold flex-none\">\n                    {name[0]}\n                  </span>\n                  {name}\n                  <span\n                    className={`lower-chk ml-auto w-4.5 h-4.5 rounded-[6px] [border:1.5px_solid_var(--line2)] grid place-items-center text-[11px] text-[var(--color-lower-sections-color-29)]${i < 2 ? \" lower-on\" : \"\"}`}\n                    role=\"img\"\n                    aria-label={i < 2 ? \"Selected\" : \"Not selected\"}\n                  >\n                    {i < 2 ? \"✓\" : \"\"}\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </article>\n        <article className=\"lower-step p-0 [background:none] [border:0] overflow-visible min-w-0 flex flex-col\">\n          <div className=\"lower-dot w-13.5 h-13.5 rounded-[50%] [background:var(--bg2)] [border:1.5px_solid_var(--line2)] grid place-items-center font-extrabold text-[18px] relative z-[1] shadow-[0_0_28px_var(--color-lower-sections-box-shadow-26)]\">\n            3\n          </div>\n          <div className=\"lower-panel backdrop-blur-[8px] mt-4.5 p-5.5 flex-1 flex flex-col [background:var(--card)] [border:1px_solid_var(--line)] rounded-[22px] relative overflow-hidden\">\n            <h3 className=\"[font-family:inherit] text-[19px] tracking-[-0.02em] font-bold\">\n              Send, then follow\n            </h3>\n            <p className=\"text-[var(--mu)] text-[14.5px] mt-1.5\">\n              One click sends individual emails from your Gmail. Track\n              submissions and mark replies manually.\n            </p>\n            <div className=\"lower-vis mt-auto rounded-[14px] [background:var(--color-lower-sections-background-27)] [border:1px_solid_var(--line)] p-3.5 lower-mini text-[12.5px]\">\n              <div\n                className=\"lower-row flex items-center gap-2.5 py-[7px] px-0 [@media(max-width:_860px)]:flex-wrap\"\n                style={{ padding: 0 }}\n              >\n                2 of 3 sent\n                <span className=\"lower-pill ml-auto py-[3px] px-2.5 rounded-full text-[11.5px] font-semibold [@media(max-width:_860px)]:whitespace-nowrap lower-ok [background:var(--color-lower-sections-background-32)] text-[var(--gr)]\">\n                  Delivered\n                </span>\n              </div>\n              <div\n                className=\"lower-bar h-1.5 rounded-[4px] [background:var(--line)] mt-3 overflow-hidden\"\n                aria-hidden=\"true\"\n              >\n                <i className=\"block h-full w-[60%] bg-[linear-gradient(90deg,var(--gr),var(--ye))]\" />\n              </div>\n              <span\n                className=\"lower-btn inline-flex items-center gap-2 py-[13px] px-6.5 rounded-full [background:var(--primary-action-gradient)] text-[var(--primary-action-ink)] [font:700_15px_var(--font-plus-jakarta),_sans-serif] [border:0] cursor-pointer shadow-none no-underline lower-s cursor-default min-h-10 py-2.5! px-4.5! text-[13.5px]! mt-3.5 w-full justify-center\"\n                aria-hidden=\"true\"\n              >\n                Send emails\n              </span>\n            </div>\n          </div>\n        </article>\n      </div>\n    </section>\n  );\n}\n","hash":"b2b86d4e0c58fb56be9e2200bd62f758825bd043d2c91d3c1e1506ad48014b91","originalHash":"b2b86d4e0c58fb56be9e2200bd62f758825bd043d2c91d3c1e1506ad48014b91","lines":125}