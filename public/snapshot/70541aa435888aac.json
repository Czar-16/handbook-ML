{"path":"src/components/pricing-table.tsx","text":"import { PLAN_COMPARISON_ROWS } from \"@/lib/plan-features\";\n\nexport function PricingTable() {\n  return (\n    <div\n      className=\"overflow-x-auto\"\n      tabIndex={0}\n      role=\"region\"\n      aria-label=\"Plan comparison\"\n    >\n      <table className=\"w-full text-left\">\n        <caption className=\"sr-only\">Free and Premium plan comparison</caption>\n        <thead>\n          <tr className=\"border-b border-dotted border-separator\">\n            <th scope=\"col\" className=\"py-3\">\n              Feature or limit\n            </th>\n            <th scope=\"col\" className=\"px-3\">\n              Free\n            </th>\n            <th scope=\"col\" className=\"px-3\">\n              Premium\n            </th>\n          </tr>\n        </thead>\n        <tbody>\n          {PLAN_COMPARISON_ROWS.map(([label, free, paid]) => (\n            <tr key={label} className=\"border-b border-dotted border-separator\">\n              <th scope=\"row\" className=\"py-3 pr-3 font-normal\">\n                {label}\n              </th>\n              <td className=\"px-3 py-3 align-top\">{free}</td>\n              <td className=\"px-3 py-3 align-top\">{paid}</td>\n            </tr>\n          ))}\n        </tbody>\n      </table>\n    </div>\n  );\n}\n","hash":"46e0bf9c605218043fdc33a9c38b25aadea01ec4b3061d13f1984c1326f1ae3b","originalHash":"46e0bf9c605218043fdc33a9c38b25aadea01ec4b3061d13f1984c1326f1ae3b","lines":41}