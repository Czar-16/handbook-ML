{"path":"src/components/history/StatusLegend.tsx","text":"export function StatusLegend() {\n  return (\n    <div className=\"space-y-2\">\n      <p>\n        <strong style={{ color: \"var(--tooltip-green)\" }}>Sent</strong>\n        <span className=\"text-body\">\n          : Gmail accepted the email. It is not confirmed delivery.\n        </span>\n      </p>\n      <p>\n        <strong style={{ color: \"var(--tooltip-yellow)\" }}>Needs review</strong>\n        <span className=\"text-body\">\n          : Check Gmail Sent. It is never automatically resent.\n        </span>\n      </p>\n      <p>\n        <strong style={{ color: \"var(--tooltip-pink)\" }}>Replied</strong>\n        <span className=\"text-body\">\n          : Marked by you. Mailloop does not read your inbox or detect replies.\n        </span>\n      </p>\n    </div>\n  );\n}\n","hash":"179531ec1e970ab9c12c8a8c2f86f8b16684b15ae7fb8251f5855e6196580892","originalHash":"179531ec1e970ab9c12c8a8c2f86f8b16684b15ae7fb8251f5855e6196580892","lines":25}