{
  "name": "mailloop-handbook",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run prepare && npm run validate",
    "build": "next build && node scripts/export-check.mjs",
    "prepare": "node scripts/prepare.mjs",
    "validate": "node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "test:browser": "playwright test",
    "snapshot:refresh": "python3 scripts/snapshot.py && npm run prepare",
    "source:verify": "python3 scripts/verify-source.py"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "mermaid": "^11.0.0",
    "shiki": "^3.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@playwright/test": "^1.56.0",
    "tsx": "^4.0.0"
  }
}
